# systemd unit for UOCHub (gunicorn behind nginx).
# Install: sudo cp deploy/uochub.service /etc/systemd/system/
#          sudo systemctl daemon-reload && sudo systemctl enable --now uochub

[Unit]
Description=UOCHub (gunicorn)
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/uochub/uochub
EnvironmentFile=/var/www/uochub/.env
RuntimeDirectory=uochub
ExecStart=/var/www/uochub/uochub/venv/bin/gunicorn \
    --workers 3 \
    --bind unix:/run/uochub/gunicorn.sock \
    uochub.wsgi:application
Restart=on-failure

[Install]
WantedBy=multi-user.target
